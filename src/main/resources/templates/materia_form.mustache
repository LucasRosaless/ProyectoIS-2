<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{{#materia}}Editar{{/materia}}{{^materia}}Nueva{{/materia}} Materia</title>
    
    <!-- Hoja de estilos global -->
    <link rel="stylesheet" href="/styles.css">
    
    <!-- Iconos Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>
<body>
    <div class="container">
        <!-- Navegación con icono de flecha hacia atrás -->
        <nav class="nav">
            <a href="/materias"><i class='bx bx-arrow-back'></i> Volver a Materias</a>
        </nav>
        
        <!-- Panel con estilo glassmorphism -->
        <div class="glass-panel">
            <h2><i class='bx bx-book-bookmark'></i> {{#materia}}Editar{{/materia}}{{^materia}}Nueva{{/materia}} Materia</h2>
            
            {{#error}}
            <div class="alert alert-error">
                <i class='bx bx-error-circle' style="vertical-align: middle; margin-right: 0.25rem;"></i>
                {{error}}
            </div>
            {{/error}}
            
            <form action="{{#materia}}/materias/{{id_materia}}/edit{{/materia}}{{^materia}}/materias/new{{/materia}}" method="POST">
                <div class="form-group">
                    <label>ID Materia</label>
                    <input type="number" name="id_materia" value="{{#materia}}{{id_materia}}{{/materia}}" {{#materia}}readonly{{/materia}} required>
                </div>
                <div class="form-group">
                    <label>Código</label>
                    <input type="text" name="codigo" value="{{#materia}}{{codigo}}{{/materia}}" required>
                </div>
                <div class="form-group">
                    <label>Nombre de la Materia</label>
                    <input type="text" name="nombre" value="{{#materia}}{{nombre}}{{/materia}}" required>
                </div>
                <div class="form-group">
                    <label>Período (ej. CUATRIMESTRAL, ANUAL)</label>
                    <select name="periodo" required>
                        <option value="CUATRIMESTRAL">CUATRIMESTRAL</option>
                        <option value="BIMESTRAL">BIMESTRAL</option>
                        <option value="ANUAL">ANUAL</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Plan de Estudio</label>
                    <select name="id_plan" required>
                        <option value="">Seleccione un plan de estudio...</option>
                        {{#planes}}
                        <option value="{{id_plan}}">Resolución: {{resolucion}} (ID: {{id_plan}})</option>
                        {{/planes}}
                    </select>
                </div>
                
                <!-- Botón de guardar con icono de disquete -->
                <button type="submit" class="btn btn-primary">
                    <i class='bx bx-save'></i> Guardar
                </button>
            </form>
        </div>
    </div>
</body>
</html>
