<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración - MiUni - Project</title>
    
    <!-- Enlace a la hoja de estilos global unificada -->
    <link rel="stylesheet" href="/styles.css">
    
    <!-- Librería de Iconos Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    
    <style>
        /* Sobrescribimos variables locales de color para adaptarla al perfil de Administración (Violeta) */
        :root {
            --primary: #8b5cf6; /* Violeta */
            --primary-hover: #7c3aed;
            --primary-glow: rgba(139, 92, 246, 0.35);
            --primary-gradient: linear-gradient(135deg, #6d28d9 0%, #8b5cf6 100%);
            --primary-gradient-hover: linear-gradient(135deg, #5b21b6 0%, #6d28d9 100%);
        }
        
        /* Gradiente radial de fondo personalizado para Administración */
        body {
            background-image: 
                radial-gradient(at 0% 0%, rgba(139, 92, 246, 0.12) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(99, 102, 241, 0.08) 0px, transparent 50%);
        }
        
        /* Grid del Panel de Control */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
            margin-bottom: 2rem;
        }
        
        /* Estilos de Tarjeta (Card) */
        .dashboard-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: flex-start;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .dashboard-card:hover {
            transform: translateY(-4px);
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(255, 255, 255, 0.12);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
        }
        
        /* Icono de la tarjeta */
        .card-icon {
            font-size: 1.75rem;
            color: var(--primary);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 3.25rem;
            height: 3.25rem;
            background: rgba(139, 92, 246, 0.1);
            border-radius: 12px;
            border: 1px solid rgba(139, 92, 246, 0.15);
        }
        
        /* Título de la tarjeta */
        .card-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.15rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--text-main);
        }
        
        /* Descripción de la tarjeta */
        .card-desc {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
            line-height: 1.4;
        }
        
        /* Contenedor de insignia de usuario */
        .user-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: rgba(139, 92, 246, 0.1);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #d8b4fe;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Navegación superior tradicional del portal de administración -->
        <nav class="nav">
            <a href="/dashboard-admin" style="font-weight: 700;">← Panel Admin</a>
            <a href="/profesores">Profesores</a>
            <a href="/alumnos">Alumnos</a>
            <a href="/carreras">Carreras</a>
            <a href="/planes">Planes</a>
            <a href="/materias">Materias</a>
        </nav>

        <!-- Panel principal Glassmorphism -->
        <div class="glass-panel">
            <div class="header-flex">
                <h2>Panel de Administración</h2>
                <div class="user-badge">
                    <i class='bx bx-user'></i>
                    <span>{{#username}}{{username}}{{/username}}{{^username}}Administrador{{/username}}</span>
                </div>
            </div>

            <!-- Alertas dinámicas Mustache -->
            {{#successMessage}}
            <div class="alert" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: #a7f3d0;">
                {{successMessage}}
            </div>
            {{/successMessage}}

            {{#errorMessage}}
            <div class="alert alert-error">
                {{errorMessage}}
            </div>
            {{/errorMessage}}

            <!-- Banner de bienvenida interno -->
            <div class="welcome-banner" style="background: linear-gradient(135deg, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0.005) 100%); border: 1px solid rgba(255,255,255,0.05); padding: 1.5rem; border-radius: 16px; margin-bottom: 2rem;">
                <h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-family: 'Outfit', sans-serif;">
                    ¡Bienvenido, {{#username}}{{username}}{{/username}}{{^username}}Administrador{{/username}}!
                </h3>
                <p style="color: var(--text-muted); font-size: 0.9rem; font-weight: 400; line-height: 1.45;">
                    Accede a las herramientas de gestión de la academia. Desde aquí puedes administrar alumnos, profesores, carreras, planes de estudio y cátedras vigentes.
                </p>
            </div>

            <!-- Rejilla de tarjetas de acceso rápido (ABM requerido) -->
            <div class="dashboard-grid">
                
                <!-- Tarjeta: Mi Perfil -->
                <div class="dashboard-card">
                    <div class="w-full">
                        <div class="card-icon"><i class='bx bx-user-circle'></i></div>
                        <h4 class="card-title">Mi Perfil</h4>
                        <p class="card-desc">Consulta tus datos personales, credenciales de cuenta y configuración de seguridad.</p>
                    </div>
                    <a href="/profile" class="btn btn-secondary w-full" style="width: 100%;">Ver Perfil</a>
                </div>

                <!-- Tarjeta: Alumnos ABM -->
                <div class="dashboard-card">
                    <div class="w-full">
                        <div class="card-icon"><i class='bx bx-group'></i></div>
                        <h4 class="card-title">Alumnos (ABM)</h4>
                        <p class="card-desc">Alta, baja, edición y visualización de expedientes académicos del alumnado.</p>
                    </div>
                    <a href="/alumnos" class="btn btn-primary w-full" style="width: 100%;">Gestionar</a>
                </div>

                <!-- Tarjeta: Profesores ABM -->
                <div class="dashboard-card">
                    <div class="w-full">
                        <div class="card-icon"><i class='bx bx-id-card'></i></div>
                        <h4 class="card-title">Profesores (ABM)</h4>
                        <p class="card-desc">Registra nuevos docentes, actualiza legajos profesionales e información de contacto.</p>
                    </div>
                    <a href="/profesores" class="btn btn-primary w-full" style="width: 100%;">Gestionar</a>
                </div>

                <!-- Tarjeta: Carreras ABM -->
                <div class="dashboard-card">
                    <div class="w-full">
                        <div class="card-icon"><i class='bx bx-git-repo-forked'></i></div>
                        <h4 class="card-title">Carreras (ABM)</h4>
                        <p class="card-desc">Administra el catálogo de carreras vigentes, años de dictado y planes curriculares.</p>
                    </div>
                    <a href="/carreras" class="btn btn-primary w-full" style="width: 100%;">Gestionar</a>
                </div>

                <!-- Tarjeta: Planes ABM -->
                <div class="dashboard-card">
                    <div class="w-full">
                        <div class="card-icon"><i class='bx bx-book'></i></div>
                        <h4 class="card-title">Planes de Estudio</h4>
                        <p class="card-desc">Administra las resoluciones oficiales, vigencia y estados de los planes académicos.</p>
                    </div>
                    <a href="/planes" class="btn btn-primary w-full" style="width: 100%;">Gestionar</a>
                </div>

                <!-- Tarjeta: Materias ABM -->
                <div class="dashboard-card">
                    <div class="w-full">
                        <div class="card-icon"><i class='bx bx-book-bookmark'></i></div>
                        <h4 class="card-title">Materias</h4>
                        <p class="card-desc">Gestiona la carga de materias, códigos de identificación y planes a los que pertenecen.</p>
                    </div>
                    <a href="/materias" class="btn btn-primary w-full" style="width: 100%;">Gestionar</a>
                </div>

                <!-- Tarjeta: Cátedras ABM -->
                <div class="dashboard-card">
                    <div class="w-full">
                        <div class="card-icon"><i class='bx bx-sitemap'></i></div>
                        <h4 class="card-title">Cátedras (ABM)</h4>
                        <p class="card-desc">Asigna personal docente a las materias correspondientes y periodos lectivos.</p>
                    </div>
                    <a href="/catedras" class="btn btn-primary w-full" style="width: 100%;">Gestionar</a>
                </div>

            </div>

            <!-- Botón de deslogueo inferior -->
            <div style="text-align: center; margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 1.5rem;">
                <a href="/logout" class="btn btn-danger">Cerrar Sesión</a>
            </div>
        </div>
    </div>
</body>
</html>