<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear una cuenta - MiUni - Project</title>
    
    <!-- Hoja de estilos global unificada -->
    <link rel="stylesheet" href="/styles.css">
    
    <!-- Iconos Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    
    <style>
        /* Contenedor central específico para centrar la tarjeta de registro en pantalla */
        .register-container {
            width: 100%;
            max-width: 450px;
            margin-top: 5vh;
            margin-bottom: 5vh;
        }
        
        /* Branding superior */
        .logo-section {
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .logo-icon {
            font-size: 3rem;
            color: var(--primary);
            background: rgba(99, 102, 241, 0.1);
            width: 5rem;
            height: 5rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 24px;
            border: 1px solid rgba(99, 102, 241, 0.15);
            margin-bottom: 1rem;
            box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.2);
        }
        
        /* Campos con iconos internos */
        .form-group-relative {
            position: relative;
            margin-bottom: 1.5rem;
        }
        
        .form-group-relative i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1.25rem;
        }
        
        .form-group-relative input, 
        .form-group-relative select {
            padding-left: 2.75rem;
        }
    </style>
</head>
<body>
    <div class="register-container">
        <!-- Encabezado de logo y título -->
        <div class="logo-section">
            <div class="logo-icon">
                <i class='bx bx-user-plus'></i>
            </div>
            <h1 style="font-family: 'Outfit', sans-serif; font-size: 2.25rem; font-weight: 800; margin-bottom: 0.25rem; color: var(--text-main);">Crear una Cuenta</h1>
            <p style="color: var(--text-muted); font-size: 0.95rem;">Regístrate para formar parte de la plataforma académica</p>
        </div>

        <!-- Tarjeta flotante con efecto cristal esmerilado -->
        <div class="glass-panel" style="padding: 2.5rem;">
            
            <!-- Mensajes de Estado Mustache -->
            {{#successMessage}}
            <div class="alert" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: #a7f3d0;">
                <i class='bx bx-check-circle' style="font-size: 1.15rem; vertical-align: middle; margin-right: 0.5rem;"></i>
                <span>{{successMessage}}</span>
            </div>
            {{/successMessage}}

            {{#errorMessage}}
            <div class="alert alert-error">
                <i class='bx bx-error-circle' style="font-size: 1.15rem; vertical-align: middle; margin-right: 0.5rem;"></i>
                <span>{{errorMessage}}</span>
            </div>
            {{/errorMessage}}

            <!-- Formulario de creación de cuenta -->
            <form action="/user/new" method="post" style="display: flex; flex-direction: column; gap: 1.25rem;">
                
                <!-- Nombre de usuario -->
                <div class="form-group" style="margin-bottom: 0;">
                    <label for="name">Nombre de Usuario</label>
                    <div class="form-group-relative">
                        <i class='bx bx-user'></i>
                        <input type="text" id="name" name="name" placeholder="Ej: lucas99" required>
                    </div>
                </div>

                <!-- Contraseña -->
                <div class="form-group" style="margin-bottom: 0;">
                    <label for="password">Contraseña</label>
                    <div class="form-group-relative">
                        <i class='bx bx-lock-alt'></i>
                        <input type="password" id="password" name="password" placeholder="••••••••" required>
                    </div>
                </div>

                <!-- Tipo de usuario -->
                <div class="form-group" style="margin-bottom: 0;">
                    <label for="tipo_usuario">Tipo de Usuario</label>
                    <div class="form-group-relative">
                        <i class='bx bx-id-card'></i>
                        <select id="tipo_usuario" name="tipo_usuario" required>
                            <option value="administrador">Administrador</option>
                            <option value="profesor">Profesor</option>
                            <option value="alumno">Alumno</option>
                        </select>
                    </div>
                </div>

                <!-- Botón de acción con degradado -->
                <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.85rem; font-size: 0.95rem; margin-top: 0.5rem;">
                    <i class='bx bx-user-plus' style="font-size: 1.2rem;"></i>
                    <span>Registrar Usuario</span>
                </button>

                <!-- Pie de tarjeta con enlaces de navegación -->
                <div style="text-align: center; margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1.25rem; font-size: 0.875rem; color: var(--text-muted);">
                    <p>¿Ya tienes una cuenta? <a href="/login" style="font-weight: 600;">Inicia sesión aquí</a></p>
                    <a href="/" style="display: inline-flex; align-items: center; gap: 0.25rem; margin-top: 1rem; color: var(--text-muted); font-size: 0.85rem;">
                        <i class='bx bx-arrow-back'></i> Volver al inicio
                    </a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>