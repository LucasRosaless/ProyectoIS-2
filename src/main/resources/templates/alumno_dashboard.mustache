<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Estudiantil - MiUni - Project</title>
    
    <!-- Enlace a la hoja de estilos global unificada -->
    <link rel="stylesheet" href="/styles.css">
    
    <!-- Librería de Iconos Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    
    <style>
        /* Sobrescribimos variables locales de color para adaptarla al perfil de Alumnos (Azul) */
        :root {
            --primary: #3b82f6; /* Azul */
            --primary-hover: #2563eb;
            --primary-glow: rgba(59, 130, 246, 0.35);
            --primary-gradient: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
            --primary-gradient-hover: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
        }
        
        /* Gradiente radial de fondo personalizado para Alumnos */
        body {
            background-image: 
                radial-gradient(at 0% 0%, rgba(59, 130, 246, 0.12) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(99, 102, 241, 0.08) 0px, transparent 50%);
        }
        

    </style>
</head>
<body>
    <div class="container">
        <!-- Navegación superior tradicional del portal de alumnos -->
        <nav class="nav">
            <a href="/dashboard-alumno" style="font-weight: 700;">← Panel Estudiante</a>
            <a href="/profile">Tu Perfil</a>
            <a href="#">Mi Carrera</a>
            <a href="#">Mis Materias</a>
            <a href="/inscripcion">Inscripción</a>
        </nav>

        <!-- Panel principal Glassmorphism -->
        <div class="glass-panel">
            <div class="header-flex">
                <h2>Portal Académico</h2>
                <div class="user-badge">
                    <i class='bx bx-user'></i>
                    <span>{{#username}}{{username}}{{/username}}{{^username}}Alumno{{/username}}</span>
                </div>
            </div>

            <!-- Alertas dinámicas Mustache -->
            {{#successMessage}}
            <div class="alert" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: #a7f3d0;">
                {{successMessage}}
            </div>
            {{/successMessage}}

            {{#errorMessage}}
            <div class="alert alert-error">
                {{errorMessage}}
            </div>
            {{/errorMessage}}

            <!-- Banner de bienvenida interno -->
            <div class="welcome-banner" style="background: linear-gradient(135deg, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0.005) 100%); border: 1px solid rgba(255,255,255,0.05); padding: 1.5rem; border-radius: 16px; margin-bottom: 2rem;">
                <h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-family: 'Outfit', sans-serif;">
                    ¡Hola, {{#username}}{{username}}{{/username}}{{^username}}Estudiante{{/username}}!
                </h3>
                <p style="color: var(--text-muted); font-size: 0.9rem; font-weight: 400; line-height: 1.45;">
                    Bienvenido a tu área estudiantil. Aquí puedes revisar tus datos de perfil, verificar el estado y progreso de tu carrera, ver las materias en curso y realizar inscripciones para los siguientes ciclos académicos.
                </p>
            </div>

            <!-- Rejilla de tarjetas de acceso rápido -->
            <div class="dashboard-grid">
                
                <!-- Tarjeta: Tu Perfil -->
                <div class="dashboard-card">
                    <div class="w-full">
                        <div class="card-icon"><i class='bx bx-user-circle'></i></div>
                        <h4 class="card-title">Tu Perfil</h4>
                        <p class="card-desc">Revisa y edita tu información personal, correo de contacto y datos institucionales.</p>
                    </div>
                    <a href="/profile" class="btn btn-secondary w-full" style="width: 100%;">Ver Perfil</a>
                </div>

                <!-- Tarjeta: Mi Carrera -->
                <div class="dashboard-card">
                    <div class="w-full">
                        <div class="card-icon"><i class='bx bx-award'></i></div>
                        <h4 class="card-title">Mi Carrera</h4>
                        <p class="card-desc">Consulta los detalles de tu plan de estudios académico y el avance general de tu plan.</p>
                    </div>
                    <a href="#" class="btn btn-primary w-full" style="width: 100%;">Próximamente</a>
                </div>

                <!-- Tarjeta: Mis Materias -->
                <div class="dashboard-card">
                    <div class="w-full">
                        <div class="card-icon"><i class='bx bx-book-open'></i></div>
                        <h4 class="card-title">Mis Materias</h4>
                        <p class="card-desc">Visualiza las materias en curso, cursadas aprobadas, notas finales y asistencias.</p>
                    </div>
                    <a href="#" class="btn btn-primary w-full" style="width: 100%;">Próximamente</a>
                </div>

                <!-- Tarjeta: Inscripción a Materias -->
                <div class="dashboard-card">
                    <div class="w-full">
                        <div class="card-icon"><i class='bx bx-edit'></i></div>
                        <h4 class="card-title">Inscripción a Materias</h4>
                        <p class="card-desc">Inscríbete a nuevas materias y seminarios habilitados para tu año de cursado.</p>
                    </div>
                    <a href="/inscripcion" class="btn btn-primary w-full" style="width: 100%;">Inscribirse</a>
                </div>

            </div>

            <!-- Botón de deslogueo inferior -->
            <div style="text-align: center; margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 1.5rem;">
                <a href="/logout" class="btn btn-danger">Cerrar Sesión</a>
            </div>
        </div>
    </div>
</body>
</html>