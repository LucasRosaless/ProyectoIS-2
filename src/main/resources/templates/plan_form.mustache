<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{{#plan}}Editar{{/plan}}{{^plan}}Nuevo{{/plan}} Plan de Estudio</title>
    
    <!-- Hoja de estilos global -->
    <link rel="stylesheet" href="/styles.css">
    
    <!-- Iconos Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>
<body>
    <div class="container">
        <!-- Navegación con icono de flecha hacia atrás -->
        <nav class="nav">
            <a href="/planes"><i class='bx bx-arrow-back'></i> Volver a Planes de Estudio</a>
        </nav>
        
        <!-- Panel con estilo glassmorphism -->
        <div class="glass-panel">
            <h2><i class='bx bx-book'></i> {{#plan}}Editar{{/plan}}{{^plan}}Nuevo{{/plan}} Plan de Estudio</h2>
            
            {{#error}}
            <div class="alert alert-error">
                <i class='bx bx-error-circle' style="vertical-align: middle; margin-right: 0.25rem;"></i>
                {{error}}
            </div>
            {{/error}}
            
            <form action="{{#plan}}/planes/{{id_plan}}/edit{{/plan}}{{^plan}}/planes/new{{/plan}}" method="POST">
                <div class="form-group">
                    <label>ID Plan</label>
                    <input type="number" name="id_plan" value="{{#plan}}{{id_plan}}{{/plan}}" {{#plan}}readonly{{/plan}} required>
                </div>
                <div class="form-group">
                    <label>Resolución</label>
                    <input type="text" name="resolucion" value="{{#plan}}{{resolucion}}{{/plan}}" required>
                </div>
                <div class="form-group">
                    <label>Año de Vigencia</label>
                    <input type="number" name="anio_vigencia" value="{{#plan}}{{anio_vigencia}}{{/plan}}" required>
                </div>
                <div class="form-group">
                    <label>Estado (ej. 1 Activo, 0 Inactivo)</label>
                    <input type="number" name="estado" value="{{#plan}}{{estado}}{{/plan}}" required>
                </div>
                <div class="form-group">
                    <label>Carrera a la que pertenece</label>
                    <select name="id_carrera" required>
                        <option value="">Seleccione una carrera...</option>
                        {{#carreras}}
                        <option value="{{id_carrera}}" >{{nombre}} (ID: {{id_carrera}})</option>
                        {{/carreras}}
                    </select>
                </div>
                
                <!-- Botón de guardar con icono de disquete -->
                <button type="submit" class="btn btn-primary">
                    <i class='bx bx-save'></i> Guardar
                </button>
            </form>
        </div>
    </div>
</body>
</html>
