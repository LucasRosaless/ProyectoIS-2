<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{{#profesor}}Editar{{/profesor}}{{^profesor}}Nuevo{{/profesor}} Profesor</title>
    
    <!-- Hoja de estilos global -->
    <link rel="stylesheet" href="/styles.css">
    
    <!-- Iconos Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>
<body>
    <div class="container">
        <!-- Navegación con icono de flecha hacia atrás -->
        <nav class="nav">
            <a href="/profesores"><i class='bx bx-arrow-back'></i> Volver a Profesores</a>
        </nav>
        
        <!-- Panel con estilo glassmorphism -->
        <div class="glass-panel">
            <h2><i class='bx bx-id-card'></i> {{#profesor}}Editar{{/profesor}}{{^profesor}}Nuevo{{/profesor}} Profesor</h2>
            
            {{#error}}
            <div class="alert alert-error">
                <i class='bx bx-error-circle' style="vertical-align: middle; margin-right: 0.25rem;"></i>
                {{error}}
            </div>
            {{/error}}
            
            <form action="{{#profesor}}/profesores/{{legajo_docente}}/edit{{/profesor}}{{^profesor}}/profesores/new{{/profesor}}" method="POST">
                <div class="form-group">
                    <label>Legajo Docente</label>
                    <input type="text" name="legajo" value="{{#profesor}}{{legajo_docente}}{{/profesor}}" {{#profesor}}readonly{{/profesor}} required>
                </div>
                <div class="form-group">
                    <label>DNI</label>
                    <input type="text" name="dni" value="{{#persona}}{{dni}}{{/persona}}" {{#profesor}}readonly{{/profesor}} required>
                </div>
                <div class="form-group">
                    <label>Nombre</label>
                    <input type="text" name="nombre" value="{{#persona}}{{nombre}}{{/persona}}" required>
                </div>
                <div class="form-group">
                    <label>Apellido</label>
                    <input type="text" name="apellido" value="{{#persona}}{{apellido}}{{/persona}}" required>
                </div>
                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <input type="email" name="correo" value="{{#persona}}{{correo}}{{/persona}}" required>
                </div>
                <div class="form-group">
                    <label>Usuario de Acceso</label>
                    <input type="text" name="user_login" value="{{#persona}}{{user_login}}{{/persona}}" required placeholder="Usuario para ingresar al sistema">
                </div>
                <div class="form-group">
                    <label>Contraseña{{#profesor}} (dejar vacío para no cambiar){{/profesor}}</label>
                    <input type="password" name="pass_login" {{^profesor}}required{{/profesor}} placeholder="{{#profesor}}Nueva contraseña (opcional){{/profesor}}{{^profesor}}Contraseña de acceso{{/profesor}}">
                </div>
                
                <!-- Botón de guardar con icono de disquete -->
                <button type="submit" class="btn btn-primary">
                    <i class='bx bx-save'></i> Guardar
                </button>
            </form>
        </div>
    </div>
</body>
</html>