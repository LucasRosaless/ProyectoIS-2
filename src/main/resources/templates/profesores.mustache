<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Profesores</title>
    
    <!-- Hoja de estilos global -->
    <link rel="stylesheet" href="/styles.css">
    
    <!-- Iconos Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>
<body>
    <div class="container">
        <!-- Barra de navegación con iconos visuales de Boxicons -->
        <nav class="nav">
            <a href="/dashboard"><i class='bx bx-arrow-back'></i> Dashboard</a>
            <a href="/profesores"><i class='bx bx-id-card'></i> Profesores</a>
            <a href="/alumnos"><i class='bx bx-group'></i> Alumnos</a>
            <a href="/carreras"><i class='bx bx-git-repo-forked'></i> Carreras</a>
            <a href="/planes"><i class='bx bx-book'></i> Planes</a>
            <a href="/materias"><i class='bx bx-book-bookmark'></i> Materias</a>
        </nav>

        <!-- Panel principal con estilo glassmorphism -->
        <div class="glass-panel">
            <div class="header-flex">
                <h2><i class='bx bx-id-card'></i> Lista de Profesores</h2>
                <a href="/profesores/new" class="btn btn-primary">
                    <i class='bx bx-plus'></i> Nuevo Profesor
                </a>
            </div>

            <!-- Tabla de profesores con iconos en las acciones -->
            <table>
                <thead>
                    <tr>
                        <th>Legajo</th>
                        <th>DNI</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Correo</th>
                        <th>Usuario</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {{#profesores}}
                    <tr>
                        <td>{{legajo_docente}}</td>
                        <td>{{dni_persona}}</td>
                        <td>{{nombre}}</td>
                        <td>{{apellido}}</td>
                        <td>{{correo}}</td>
                        <td>{{user_login}}</td>
                        <td class="actions">
                            <a href="/profesores/{{legajo_docente}}/edit" class="btn btn-secondary">
                                <i class='bx bx-edit-alt'></i> Editar
                            </a>
                            <a href="/profesores/{{legajo_docente}}/materias" class="btn btn-primary">
                                <i class='bx bx-book-reader'></i> Materias
                            </a>
                            <form action="/profesores/{{legajo_docente}}/delete" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('¿Seguro que desea eliminar a este profesor?');">
                                    <i class='bx bx-trash'></i> Borrar
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/profesores}}
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
