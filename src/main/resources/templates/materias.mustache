<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Gestión de Materias</title>
    
    <!-- Hoja de estilos global -->
    <link rel="stylesheet" href="/styles.css">
    
    <!-- Iconos Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>
<body>
    <div class="container">
        <!-- Barra de navegación con iconos visuales de Boxicons -->
        <nav class="nav">
            <a href="/dashboard"><i class='bx bx-arrow-back'></i> Dashboard</a>
            <a href="/profesores"><i class='bx bx-id-card'></i> Profesores</a>
            <a href="/alumnos"><i class='bx bx-group'></i> Alumnos</a>
            <a href="/carreras"><i class='bx bx-git-repo-forked'></i> Carreras</a>
            <a href="/planes"><i class='bx bx-book'></i> Planes</a>
            <a href="/materias"><i class='bx bx-book-bookmark'></i> Materias</a>
        </nav>

        <!-- Panel principal con estilo glassmorphism -->
        <div class="glass-panel">
            <div class="header-flex">
                <h2><i class='bx bx-book-bookmark'></i> Lista de Materias</h2>
                <a href="/materias/new" class="btn btn-primary">
                    <i class='bx bx-plus'></i> Nueva Materia
                </a>
            </div>

            <!-- Tabla de materias con iconos en las acciones -->
            <table>
                <thead>
                    <tr>
                        <th>ID Materia</th>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Período</th>
                        <th>ID Plan</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {{#materias}}
                    <tr>
                        <td>{{id_materia}}</td>
                        <td>{{codigo}}</td>
                        <td>{{nombre}}</td>
                        <td>{{periodo}}</td>
                        <td>{{id_plan}}</td>
                        <td class="actions">
                            <a href="/materias/{{id_materia}}/edit" class="btn btn-secondary">
                                <i class='bx bx-edit-alt'></i> Editar
                            </a>
                            <form action="/materias/{{id_materia}}/delete" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('¿Seguro que desea eliminar esta materia?');">
                                    <i class='bx bx-trash'></i> Borrar
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/materias}}
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
