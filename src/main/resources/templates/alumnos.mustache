<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Gestión de Alumnos</title>
    
    <!-- Hoja de estilos global -->
    <link rel="stylesheet" href="/styles.css">
    
    <!-- Iconos Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>
<body>
    <div class="container">
        <!-- Barra de navegación con iconos visuales de Boxicons -->
        <nav class="nav">
            <a href="/dashboard"><i class='bx bx-arrow-back'></i> Dashboard</a>
            <a href="/profesores"><i class='bx bx-id-card'></i> Profesores</a>
            <a href="/alumnos"><i class='bx bx-group'></i> Alumnos</a>
            <a href="/carreras"><i class='bx bx-git-repo-forked'></i> Carreras</a>
            <a href="/planes"><i class='bx bx-book'></i> Planes</a>
            <a href="/materias"><i class='bx bx-book-bookmark'></i> Materias</a>
        </nav>

        <!-- Panel principal con estilo glassmorphism -->
        <div class="glass-panel">
            <div class="header-flex">
                <h2><i class='bx bx-group'></i> Lista de Alumnos</h2>
                <a href="/alumnos/new" class="btn btn-primary">
                    <i class='bx bx-plus'></i> Nuevo Alumno
                </a>
            </div>

            <!-- Tabla de alumnos con iconos en las acciones -->
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Legajo</th>
                            <th>DNI</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Correo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#alumnos}}
                        <tr>
                            <td>{{legajo}}</td>
                            <td>{{dni_persona}}</td>
                            <td>{{nombre}}</td>
                            <td>{{apellido}}</td>
                            <td>{{correo}}</td>
                            <td class="actions">
                                <a href="/alumnos/{{legajo}}/edit" class="btn btn-secondary">
                                    <i class='bx bx-edit-alt'></i> Editar
                                </a>
                                <form action="/alumnos/{{legajo}}/delete" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-danger" onclick="return confirm('¿Seguro que desea eliminar a este alumno?');">
                                        <i class='bx bx-trash'></i> Borrar
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {{/alumnos}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
