<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{{#carrera}}Editar{{/carrera}}{{^carrera}}Nueva{{/carrera}} Carrera</title>
    
    <!-- Hoja de estilos global -->
    <link rel="stylesheet" href="/styles.css">
    
    <!-- Iconos Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>
<body>
    <div class="container">
        <!-- Navegación con icono de flecha hacia atrás -->
        <nav class="nav">
            <a href="/carreras"><i class='bx bx-arrow-back'></i> Volver a Carreras</a>
        </nav>
        
        <!-- Panel con estilo glassmorphism -->
        <div class="glass-panel">
            <h2><i class='bx bx-git-repo-forked'></i> {{#carrera}}Editar{{/carrera}}{{^carrera}}Nueva{{/carrera}} Carrera</h2>
            
            {{#error}}
            <div class="alert alert-error">
                <i class='bx bx-error-circle' style="vertical-align: middle; margin-right: 0.25rem;"></i>
                {{error}}
            </div>
            {{/error}}
            
            <form action="{{#carrera}}/carreras/{{id_carrera}}/edit{{/carrera}}{{^carrera}}/carreras/new{{/carrera}}" method="POST">
                <div class="form-group">
                    <label>ID Carrera</label>
                    <input type="number" name="id_carrera" value="{{#carrera}}{{id_carrera}}{{/carrera}}" {{#carrera}}readonly{{/carrera}} required>
                </div>
                <div class="form-group">
                    <label>Código</label>
                    <input type="number" name="codigo" value="{{#carrera}}{{codigo}}{{/carrera}}" required>
                </div>
                <div class="form-group">
                    <label>Nombre de la Carrera</label>
                    <input type="text" name="nombre" value="{{#carrera}}{{nombre}}{{/carrera}}" required>
                </div>
                <div class="form-group">
                    <label>Duración (Años)</label>
                    <input type="number" name="duracion_anios" value="{{#carrera}}{{duracion_anios}}{{/carrera}}" required>
                </div>
                
                <!-- Botón de guardar con icono de disquete -->
                <button type="submit" class="btn btn-primary">
                    <i class='bx bx-save'></i> Guardar
                </button>
            </form>
        </div>
    </div>
</body>
</html>
